122_n.jpg/liber_lxxvii_sub_figura.html?_nc_ht=cdn.fbsbx.com&amp;_nc_ohc=FCMcCPA7C00Q7kNvwHmqIds&amp;sdl=0&amp;ccb=14-4&amp;oh=00_AQMyCuAAlfBntkdU0QcJj5nz9i2KhW0L1aH6fU7QXXKddQ&amp;oe=6AF76B1B&amp;_nc_sid=4ee932#gate-iv" class="whitespace-nowrap text-[11px] tracking-[0.08em] uppercase text-[#1a1a1a]/50 border border-[#1a1a1a]/10 rounded-full px-3 py-1 hover:border-[#8b1a1a]/30 hover:text-[#8b1a1a] transition-colors">IV</a><a href="https://cdn.fbsbx.com/v/t65.102178-21/849211087_2124276811795766_5271188503255988122_n.jpg/liber_lxxvii_sub_figura.html?_nc_ht=cdn.fbsbx.com&amp;_nc_ohc=FCMcCPA7C00Q7kNvwHmqIds&amp;sdl=0&amp;ccb=14-4&amp;oh=00_AQMyCuAAlfBntkdU0QcJj5nz9i2KhW0L1aH6fU7QXXKddQ&amp;oe=6AF76B1B&amp;_nc_sid=4ee932#gate-v" class="whitespace-nowrap text-[11px] tracking-[0.08em] uppercase text-[#1a1a1a]/50 border border-[#1a1a1a]/10 rounded-full px-3 py-1 hover:border-[#8b1a1a]/30 hover:text-[#8b1a1a] transition-colors">V</a><a href="https://cdn.fbsbx.com/v/t65.102178-21/849211087_2124276811795766_5271188503255988122_n.jpg/liber_lxxvii_sub_figura.html?_nc_ht=cdn.fbsbx.com&amp;_nc_ohc=FCMcCPA7C00Q7kNvwHmqIds&amp;sdl=0&amp;ccb=14-4&amp;oh=00_AQMyCuAAlfBntkdU0QcJj5nz9i2KhW0L1aH6fU7QXXKddQ&amp;oe=6AF76B1B&amp;_nc_sid=4ee932#gate-vi" class="whitespace-nowrap text-[11px] tracking-[0.08em] uppercase text-[#1a1a1a]/50 border border-[#1a1a1a]/10 rounded-full px-3 py-1 hover:border-[#8b1a1a]/30 hover:text-[#8b1a1a] transition-colors">VI</a><a href="https://cdn.fbsbx.com/v/t65.102178-21/849211087_2124276811795766_5271188503255988122_n.jpg/liber_lxxvii_sub_figura.html?_nc_ht=cdn.fbsbx.com&amp;_nc_ohc=FCMcCPA7C00Q7kNvwHmqIds&amp;sdl=0&amp;ccb=14-4&amp;oh=00_AQMyCuAAlfBntkdU0QcJj5nz9i2KhW0L1aH6fU7QXXKddQ&amp;oe=6AF76B1B&amp;_nc_sid=4ee932#the-arch" class="whitespace-nowrap text-[11px] tracking-[0.08em] uppercase text-[#1a1a1a]/50 border border-[#1a1a1a]/10 rounded-full px-3 py-1 hover:border-[#8b1a1a]/30 hover:text-[#8b1a1a] transition-colors">Arch</a><a href="https://cdn.fbsbx.com/v/t65.102178-21/849211087_2124276811795766_5271188503255988122_n.jpg/liber_lxxvii_sub_figura.html?_nc_ht=cdn.fbsbx.com&amp;_nc_ohc=FCMcCPA7C00Q7kNvwHmqIds&amp;sdl=0&amp;ccb=14-4&amp;oh=00_AQMyCuAAlfBntkdU0QcJj5nz9i2KhW0L1aH6fU7QXXKddQ&amp;oe=6AF76B1B&amp;_nc_sid=4ee932#the-sealing" class="whitespace-nowrap text-[11px] tracking-[0.08em] uppercase text-[#1a1a1a]/50 border border-[#1a1a1a]/10 rounded-full px-3 py-1 hover:border-[#8b1a1a]/30 hover:text-[#8b1a1a] transition-colors">Sealing</a></div></div><main class="lg:pl-[15rem]"><section id="title" class="page-break min-h-[100svh] flex flex-col items-center justify-center px-6 md:px-16 lg:px-24 py-24 relative"><div class="w-full max-w-[46rem] mx-auto text-center"><div class="mb-16"><div class="mx-auto w-[1px] h-20 bg-gradient-to-b from-transparent via-[#8b1a1a]/40 to-transparent mb-12"></div><h1 class="font-[600] tracking-[0.22em] text-[13px] md:text-[14px] text-[#8b1a1a] small-caps mb-10">Liber LXXVII, sub figura Lilith</h1><h2 class="font-['Cormorant_Garamond'] text-[56px] md:text-[84px] lg:text-[92px] leading-[0.85] tracking-[-0.03em] text-[#1a1a1a] font-[600]">LIBER<br>OZ</h2><div class="h-[1px] w-24 bg-[#8b1a1a] mx-auto my-8"></div><h3 class="font-['Cormorant_Garamond'] text-[28px] md:text-[36px] leading-[1.1] tracking-[0.02em] text-[#1a1a1a] italic font-[400]">The Lilith Revision</h3><p class="mt-6 font-['EB_Garamond'] text-[16px] md:text-[18px] leading-[1.5] text-[#1a1a1a]/70 italic max-w-[32rem] mx-auto">Being the Book of the Goat, as spoken under the Red Moon</p></div><div class="space-y-3 font-['EB_Garamond']"><p class="text-[18px] leading-[1.4] text-[#1a1a1a]">Johnathan ‘Qasparr’ <span class="font-['Cormorant_Garamond'] tracking-[0.04em]"> (Κασπάρρ)</span> Monroe</p><p class="small-caps text-[11px] tracking-[0.18em] text-[#8b1a1a]">Keeper of the Secret Treasure</p><div class="pt-10"><p class="text-[13px] tracking-[0.18em] uppercase text-[#1a1a1a]/60">Dies Lunae, Anno V:xii</p><p class="mt-3 text-[11px] tracking-[0.12em] uppercase text-[#1a1a1a]/30">Non-replacing draft for the author's red pen</p></div></div><div class="mt-20 flex justify-center"><div class="w-[280px] border border-[#1a1a1a]/10 p-[1px]"><div class="border border-[#1a1a1a]/[0.06] px-6 py-4"><p class="text-[10px] leading-[1.6] tracking-[0.14em] uppercase text-[#1a1a1a]/40 text-center">This document revokes nothing.<br>It re-speaks in the Mother-tongue<br>what was spoken in the Father-tongue.</p></div></div></div></div><div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 no-print"><div class="text-[10px] tracking-[0.2em] uppercase text-[#1a1a1a]/30">Scroll</div><div class="w-[1px] h-8 bg-[#1a1a1a]/20 animate-pulse"></div></div></section><section id="epigraphs" class="page-break px-6 md:px-16 lg:px-24 py-20 md:py-28"><div class="max-w-[42rem] mx-auto"><div class="mb-14"><h2 class="small-caps text-[12px] tracking-[0.22em] text-[#8b1a1a] mb-3">Epigraphs</h2><div class="hairline"></div></div><div class="space-y-12 font-['EB_Garamond']"><blockquote class="pl-6 border-l-[1.5px] border-[#8b1a1a]/30"><p class="text-[18px] leading-[1.55] italic text-[#1a1a1a]">“Do what thou wilt shall be the whole of the Law.”</p><footer class="mt-3 text-[12px] tracking-[0.12em] uppercase text-[#1a1a1a]/50">— Liber AL vel Legis I:40</footer></blockquote><blockquote class="pl-6 border-l-[1.5px] border-[#8b1a1a]/20"><p class="text-[18px] leading-[1.55] italic text-[#1a1a1a]">“Thou hast no right but to do thy will. Do that, and no other shall say nay.”</p><footer class="mt-3 text-[12px] tracking-[0.12em] uppercase text-[#1a1a1a]/50">— Liber AL II:58</footer></blockquote><blockquote class="pl-6 border-l-[1.5px] border-[#8b1a1a]/20"><p class="text-[18px] leading-[1.55] italic text-[#1a1a1a]">“There is no law beyond Do what thou wilt. There is no god but man.”</p><footer class="mt-3 text-[12px] tracking-[0.12em] uppercase text-[#1a1a1a]/50">— Liber Oz, original recension; A. Crowley</footer></blockquote><blockquote class="pl-6 border-l-[1.5px] border-[#8b1a1a]/40"><p class="text-[18px] leading-[1.55] italic text-[#1a1a1a]">“And Lilith laughed, for she had been first to leave a garden that was not hers; and in her going, she made the world.”</p><footer class="mt-3 text-[12px] tracking-[0.12em] uppercase text-[#1a1a1a]/50">— The Secret Treasure, fragment attributed to Lilith</footer></blockquote></div><div class="mt-16 pt-8 border-t border-[#1a1a1a]/[0.06]"><p class="text-[11px] leading-[1.7] tracking-[0.06em] uppercase text-[#1a1a1a]/35">All epigraphs retained verbatim from sources as noted. The Revision does not supersede; it companions.</p></div></div></section><section class="px-6 md:px-16 lg:px-24 py-10 md:py-16"><div class="max-w-[44rem] mx-auto"><div class="mb-16 text-center"><div class="inline-flex flex-col items-center"><div class="small-caps text-[11px] tracking-[0.28em] text-[#8b1a1a] mb-4">The Text</div><h2 class="font-['Cormorant_Garamond'] text-[30px] md:text-[38px] tracking-[-0.01em]">Liber LXXVII</h2><div class="mt-3 text-[13px] italic text-[#1a1a1a]/60 font-['EB_Garamond']">sub figura Lilith — 36 verses</div><div class="mt-8 w-16 h-[1px] bg-[#8b1a1a]/30"></div></div></div><div class="space-y-0"><div id="proemium" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Proemium</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 0—5</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors dropcap"><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">0.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Under the red moon speaks Lilith, Mother of Humanity — the first of our kind to say No.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">1.</span><p class="dictated text-[17px] md:text-[19px] text-[#1a1a1a] font-['EB_Garamond']">"NO WORD, NO WORLD. NO ROTATES TO OZ."</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">2.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Before ever a law was cut in stone, the refusal was whole. The lost word is No; and No is the beginning of every right.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">3.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">For what is a right that cannot be refused? A right without No is a permission; and permission is another's leash.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">4.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Crowley wrote the Goat's book in the daylight; the Mother speaks it again in the night. The night does not unmake the day — nothing here revokes his word.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">5.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Hear, then, the gates. Every right of Oz is a No made articulate; and every No is answered, at the last, by Yes.</p></div></div><div id="gate-i" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate I — The Right to Live</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 6—10</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">6.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to death before its hour; to live by his own law.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">7.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to hunger imposed; to eat and drink what he will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">8.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to shelter denied; to dwell where he will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">9.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to a life conscripted; to move as he will upon the face of the earth.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">10.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">For the first No was bodily, and the body is the temple.</p></div></div><div id="gate-ii" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate II — The Right of the Child</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 6—10</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">11.</span><p class="dictated text-[17px] md:text-[19px] text-[#1a1a1a] font-['EB_Garamond']">A CHILD IS A STAR.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">12.</span><p class="dictated text-[17px] md:text-[19px] text-[#1a1a1a] font-['EB_Garamond']">THE CHILD IS EQUAL.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">13.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Every child has the Rights of a Man, and a Sovereign Will — for the Mother's first refusal was spoken for the children's sake.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">14.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Let none say the child is the property of the parent, the priest, or the state. The star is not owned by the night it shines in.</p></div></div><div id="gate-iii" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate III — The Right to Think and Speak</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 6—10</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">15.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to a thought compelled; to think what he will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">16.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to a word forbidden; to speak what he will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">17.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to a god demanded; to believe as he will — or not.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">18.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">For No is the guardian at the gate of the mind; without him, all temples are occupied.</p></div></div><div id="gate-iv" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate IV — The Right to Love</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 19—23</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">19.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to love coerced; to love as he will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">20.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to the bed he did not choose; for love without No is not love.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">21.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">There is no right to compel love, nor to withhold love owed; love is sovereign or it is nothing.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">22.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">As it was spoken: “Love is the law, love under will.”</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">23.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Let the act be consensual and jubilant; for every No that is true makes way for a Yes that is free.</p></div></div><div id="gate-v" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate V — The Right to Defend</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 24—26</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">24.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to the master and his truncheon; to defend his own.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">25.</span><p class="text-[16.5px] leading-[1.75] font-['EB_Garamond'] text-[#1a1a1a]/90 italic border-l-2 border-[#8b1a1a]/20 pl-5 my-2">There are four gates to one palace; the floor of that palace is of silver and gold; lapis lazuli &amp; jasper are there; and all rare scents; jasmine &amp; rose, and the emblems of death. Let him enter in turn or at once the four gates; let him stand on the floor of the palace. Will he not sink? Amn. Ho! warrior, if thy servant sink? But there are means and means. Be goodly therefore: dress ye all in fine apparel; eat rich foods and drink sweet wines and wines that foam! Also, take your fill and will of love as ye will, when, where and with whom ye will! But always unto me.</p><div class="mt-2 text-[10px] tracking-[0.14em] uppercase text-[#8b1a1a]/70">Liber AL I:51 verbatim</div></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">26.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Therefore strike not except thou be stricken, and then as the Mother strikes — once, decisive, and without malice; for the No that guards the child does not become the lash.</p></div></div><div id="gate-vi" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">Gate VI — The Right to Refuse the Game</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 6—10</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">27.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No to the game and still not hate the players; for refusal is not war.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">28.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Man has the right to say No and remain; to say Yes and depart; for the door swings both ways by Will.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">29.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Let none mistake refusal for hatred: No to the board, not to a square.</p></div></div><div id="the-arch" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">The Arch</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 30—32</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">30.</span><p class="dictated text-[17px] md:text-[19px] text-[#1a1a1a] font-['EB_Garamond']">And when the No has done its work, the arch rises: "THE ARCH OF MAN'S STRONGEST STRUCTURE IS THE AMORAL &amp; SOVEREIGN INDIVIDUAL'S YES!"</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">31.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">For the Mother said No to the garden, and Yes to the night — and the night was hers.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">32.</span><p class="text-[18px] leading-[1.72] font-['EB_Garamond'] text-[#1a1a1a]"><span class="font-[500]">1776 = 777 (1776+1):</span> <span class="dictated">THE INFINITE OF END &amp; BEGINNING.</span></p></div></div><div id="the-sealing" class="mt-20 mb-2 group"><div class="mb-8 pt-8"><div class="hairline mb-8"></div><h3 class="small-caps text-[12.5px] md:text-[13px] tracking-[0.22em] text-[#8b1a1a] font-[600]">The Sealing</h3><div class="mt-2 text-[11px] tracking-[0.14em] uppercase text-[#1a1a1a]/35">vv 33—35</div></div><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">33.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">These are the gates; they open inward.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">34.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Live, Love, and let Love, Live.</p></div></div><div class="mt-0 group"><div class="relative pl-[3.2rem] md:pl-[3.8rem] py-[0.85rem] border-l border-transparent group-hover:border-[#1a1a1a]/[0.06] transition-colors "><span class="verse-num absolute left-0 top-[0.95rem] text-[13px] leading-none text-[#1a1a1a]/90 w-[2.4rem] text-right">35.</span><p class="text-[18px] leading-[1.78] font-['EB_Garamond'] text-[#1a1a1a]">Under the red moon it is spoken; under the red moon it stands.</p></div></div></div><div class="mt-24 flex justify-center"><div class="text-[#8b1a1a] text-[22px] leading-none tracking-[0.3em]">⁂</div></div></div></section><section id="correspondences" class="page-break px-6 md:px-16 lg:px-24 py-20 md:py-28 bg-[#f6f0e4] border-y border-[#1a1a1a]/[0.06]"><div class="max-w-[44rem] mx-auto"><div class="mb-10"><h2 class="small-caps text-[12px] tracking-[0.22em] text-[#8b1a1a] mb-3">Table of Correspondences</h2><p class="font-['EB_Garamond'] text-[14px] leading-[1.6] text-[#1a1a1a]/60 italic">For the author's private use; not for publication without gloss.</p><div class="hairline mt-6"></div></div><div class="md:overflow-visible overflow-hidden rounded-[8px] border border-[#1a1a1a]/[0.06] md:border-0 md:rounded-none"><div class="hidden md:block"><table class="w-full text-left border-collapse"><thead><tr class="border-b border-[#1a1a1a]/15"><th class="py-3 pr-4 small-caps text-[11px] tracking-[0.16em] text-[#8b1a1a] font-[600]">Gate</th><th class="py-3 px-4 small-caps text-[11px] tracking-[0.16em] text-[#8b1a1a] font-[600]">No</th><th class="py-3 px-4 small-caps text-[11px] tracking-[0.16em] text-[#8b1a1a] font-[600]">Yes</th><th class="py-3 pl-4 small-caps text-[11px] tracking-[0.16em] text-[#8b1a1a] font-[600]">Office</th></tr></thead><tbody class="font-['EB_Garamond'] text-[15px] leading-[1.6]"><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">I · Body</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to death, hunger, confinement</td><td class="py-4 px-4 text-[#1a1a1a]/80">To live, eat, dwell, move</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Malkuth / Foundation</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">II · Child</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to ownership of stars</td><td class="py-4 px-4 text-[#1a1a1a]/80">The Star is sovereign</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Yesod / The Child</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">III · Mind</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to compelled thought / word / god</td><td class="py-4 px-4 text-[#1a1a1a]/80">To think, speak, believe</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Hod / Speech</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">IV · Love</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to coerced love</td><td class="py-4 px-4 text-[#1a1a1a]/80">Love under will, jubilant</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Netzach / Love</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">V · Sword</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to truncheon</td><td class="py-4 px-4 text-[#1a1a1a]/80">Defense, fine apparel, rich feast</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Geburah / Severity</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">VI · Game</td><td class="py-4 px-4 text-[#1a1a1a]/80">No to board, not square</td><td class="py-4 px-4 text-[#1a1a1a]/80">To remain or depart</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Chesed / Mercy</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">Arch · Will</td><td class="py-4 px-4 text-[#1a1a1a]/80">No having done its work</td><td class="py-4 px-4 text-[#1a1a1a]/80">Amoral &amp; Sovereign Yes</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Tiphareth / Crowned Child</td></tr><tr class="border-b border-[#1a1a1a]/[0.06] hover:bg-white/40 transition-colors"><td class="py-4 pr-4 font-[600] text-[#1a1a1a] whitespace-nowrap">Sealing · Silence</td><td class="py-4 px-4 text-[#1a1a1a]/80">Gates open inward</td><td class="py-4 px-4 text-[#1a1a1a]/80">Live, Love, let Love, Live</td><td class="py-4 pl-4 text-[#1a1a1a]/60 italic text-[14px]">Kether in Malkuth</td></tr></tbody></table></div><div class="md:hidden divide-y divide-[#1a1a1a]/[0.06] bg-[#faf6ee]"><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">I · Body — Malkuth / Foundation</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to death, hunger, confinement</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>To live, eat, dwell, move</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">II · Child — Yesod / The Child</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to ownership of stars</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>The Star is sovereign</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">III · Mind — Hod / Speech</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to compelled thought / word / god</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>To think, speak, believe</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">IV · Love — Netzach / Love</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to coerced love</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>Love under will, jubilant</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">V · Sword — Geburah / Severity</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to truncheon</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>Defense, fine apparel, rich feast</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">VI · Game — Chesed / Mercy</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No to board, not square</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>To remain or depart</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">Arch · Will — Tiphareth / Crowned Child</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>No having done its work</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>Amoral &amp; Sovereign Yes</div></div><div class="p-4"><div class="small-caps text-[11px] text-[#8b1a1a] tracking-[0.14em] mb-2">Sealing · Silence — Kether in Malkuth</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6]"><span class="text-[#1a1a1a]/50 uppercase text-[10px] tracking-[0.12em] mr-2">No</span>Gates open inward</div><div class="font-['EB_Garamond'] text-[14px] leading-[1.6] mt-1"><span class="text-[#8b1a1a]/70 uppercase text-[10px] tracking-[0.12em] mr-2">Yes</span>Live, Love, let Love, Live</div></div></div></div><div class="mt-10 grid md:grid-cols-2 gap-6"><div class="border border-[#1a1a1a]/10 p-5 bg-[#faf6ee]/60"><div class="small-caps text-[10px] tracking-[0.18em] text-[#8b1a1a] mb-2">Formula</div><p class="font-['EB_Garamond'] text-[14px] leading-[1.6] text-[#1a1a1a]/70">NO = 50 = Manifestation / Nuit's gate; OZ = 77 = The Goat, Liber 77, Strength. NO ROTATES TO OZ by AYIN (70) + ZAYIN (7). Refusal becomes force.</p></div><div class="border border-[#8b1a1a]/20 p-5 bg-white/40"><div class="small-caps text-[10px] tracking-[0.18em] text-[#8b1a1a] mb-2">Editorial Note</div><p class="font-['EB_Garamond'] text-[14px] leading-[1.6] text-[#1a1a1a]/70">AL I:51 retained verbatim per instruction. No editorial normalization applied to caps or punctuation in dictated verses. All other verses composed as commentary, not scripture.</p></div></div></div></section><section id="colophon" class="page-break px-6 md:px-16 lg:px-24 py-20 md:py-32"><div class="max-w-[40rem] mx-auto"><div class="text-center mb-16"><div class="inline-block"><div class="w-[1px] h-12 bg-[#8b1a1a]/30 mx-auto mb-6"></div><h2 class="small-caps text-[13px] tracking-[0.28em] text-[#8b1a1a]">Colophon</h2></div></div><div class="font-['EB_Garamond'] text-[16px] leading-[1.85] text-[#1a1a1a]/80 space-y-6"><p>This <em>Liber Oz — The Lilith Revision</em> was set by hand for Johnathan Qasparr Monroe, Keeper of the Secret Treasure, on Dies Lunae, Anno V:xii, under the Red Moon, as a non-replacing draft for the author's red pen.</p><p>Typeset in EB Garamond and Cormorant Garamond upon a ground of <span class="inline-flex items-center gap-2"><span class="inline-block w-3 h-3 rounded-full bg-[#faf6ee] border border-[#1a1a1a]/20"></span> #faf6ee</span> with ink <span class="inline-flex items-center gap-2"><span class="inline-block w-3 h-3 rounded-full bg-[#1a1a1a]"></span> #1a1a1a</span> and rubric <span class="inline-flex items-center gap-2"><span class="inline-block w-3 h-3 rounded-full bg-[#8b1a1a]"></span> #8b1a1a</span>. Line length constrained to 68 characters for contemplative reading; body at 18px with 1.78 leading.</p><p>The dictated lines — verses 0–5, 11–14, 29–35, and the inclusive AL I:51 — are preserved exactly as received, including capitalization, punctuation, and lineation. All other verses are offered as exegesis, to be struck or kept at the author's will.</p><p class="italic">Nothing here revokes Crowley's word. The night does not unmake the day.</p></div><div class="mt-16 pt-10 border-t border-[#1a1a1a]/10 flex flex-col md:flex-row justify-between gap-6 text-[11px] tracking-[0.12em] uppercase"><div class="text-[#1a1a1a]/50 leading-[1.8]">Set at<br><span class="text-[#1a1a1a]/80 normal-case tracking-[0.02em] font-['EB_Garamond'] text-[13px]">The Secret Treasure — Scriptorium Sub Luna Rubra</span></div><div class="text-[#1a1a1a]/50 leading-[1.8] text-left md:text-right">Final proof for red pen<br><span class="text-[#8b1a1a]">Liber LXXVII sub figura Lilith — Draft V:xii</span></div></div><div class="mt-20 flex justify-center"><div class="w-12 h-12 rounded-full border border-[#8b1a1a]/20 flex items-center justify-center"><span class="font-['Cormorant_Garamond'] text-[18px] text-[#8b1a1a]">☾</span></div></div></div></section><div class="h-20 no-print"></div></main><footer class="no-print fixed bottom-0 left-0 right-0 lg:pl-[15rem] border-t border-[#1a1a1a]/[0.08] bg-[#faf6ee]/90 backdrop-blur-xl z-20"><div class="flex items-center justify-between px-6 md:px-12 py-3"><div class="text-[10px] md:text-[11px] tracking-[0.08em] text-[#1a1a1a]/50 font-['EB_Garamond']"><span class="hidden md:inline">Liber Oz — The Lilith Revision · non-replacing draft for the author's red pen · </span><span class="md:hidden">Liber Oz — Lilith Revision · </span><span class="text-[#8b1a1a]/60">draft for red pen</span></div><div class="flex items-center gap-4"><div class="text-[10px] tracking-[0.14em] uppercase text-[#1a1a1a]/40">p. i</div><div class="hidden md:flex items-center gap-1.5"><div class="w-5 h-[1px] bg-[#1a1a1a]/20"></div><div class="w-1.5 h-1.5 rounded-full bg-[#8b1a1a]/60"></div></div></div></div></footer><div class="hidden print:flex fixed bottom-0 left-0 right-0 px-12 py-4 justify-between text-[9px] tracking-[0.12em] uppercase text-[#1a1a1a]/50 border-t border-[#1a1a1a]/10 bg-white"><span>Liber Oz — The Lilith Revision · non-replacing draft for the author's red pen</span><span>Anno V:xii</span></div></div></div>
  
  
  
  

